TUNNEL_TOKEN=your-cloudflare-tunnel-token-here
TZ=UTC

# Host network identity. Set this to the server's static LAN address.
LAN_IP=192.168.1.10
ADGUARD_WEB_PORT=3001
GITEA_SSH_PORT=2222

# Private (Tier B) transport (docs/tailscale.md). Keep false until the
# host-level Tailscale install is done (deployment.md). When true, install.sh
# requires the tailscale binary and a tailscale0 IPv4, and writes the detected
# address to TAILSCALE_IP for Tier B service binds. REQUIRED for the `env`
# profile (the Infisical env store is reachable only through Tailscale).
TAILSCALE_ENABLED=false
TAILSCALE_IP=

# Optional service profiles to enable, comma-separated (empty = base stack only).
#   dns  - AdGuard Home network DNS + ad-blocking. Enabling this lets install.sh
#          reconfigure the HOST resolver (disable systemd-resolved stub, repoint
#          /etc/resolv.conf, allow rootless port 53). Leave off unless you want
#          this machine to be your LAN DNS server.
#   mgmt - Portainer (requires PODMAN_SOCKET_PATH).
#   chat - Mattermost + PostgreSQL (requires MATTERMOST_DB_PASSWORD and
#          MATTERMOST_SUBDOMAIN).
#   env  - Infisical env/secret store (requires TAILSCALE_ENABLED=true plus
#          INFISICAL_ENCRYPTION_KEY, INFISICAL_AUTH_SECRET, INFISICAL_DB_PASSWORD).
#   db   - Application database: PostgreSQL + Adminer for your own backends.
#          Private (Tier B): reachable only over Tailscale, never through
#          Cloudflare. Requires TAILSCALE_ENABLED=true and the APPDB_* values
#          below; install.sh refuses the profile without them.
#   analytics - Umami web analytics (requires TAILSCALE_ENABLED=true plus the
#          UMAMI_* values below).
#   monitoring - GlitchTip app-error monitoring (requires TAILSCALE_ENABLED=true
#          plus the GLITCHTIP_* values below).
LOCALCLOUD_PROFILES=

# Dev (macOS): ./mock-usb
# Prod (Ubuntu Server): /mnt/usb-disk
BACKUP_DEST_PATH=./mock-usb

# Dev: mock-usb is a plain dir, so skip the mount guard.
BACKUP_REQUIRE_MOUNT=false
# Prod: enforce USB mount by setting BACKUP_REQUIRE_MOUNT=true on server.

# Encrypted, versioned restic backups. Generate a long value and keep it off
# the USB drive:
#   openssl rand -base64 48
RESTIC_PASSWORD=change-me-run-openssl-rand-base64-48
# RESTIC_REPOSITORY is deliberately NOT set here. It is a path inside the backup
# container, where BACKUP_DEST_PATH is mounted at /backup, so /backup/restic-repo
# is its only correct value whatever BACKUP_DEST_PATH is - and the backup
# container runs with network_mode: none, so a remote repository cannot work
# either. Leaving it unset lets docker-compose.yml supply the right value.
#
# Setting it to the host path is the mistake worth avoiding: restic would create
# the repository in the container's own writable layer, report successful
# snapshots, and lose them on the next recreate, while the backup disk stayed
# empty. backup.sh now refuses anything outside /backup.
RESTIC_HOST=localcloud
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=6

# Domain standardization - single source of truth for Cloudflare
# Zero Trust Public Hostname routing (configured manually in dashboard).
BASE_DOMAIN=localcloud.example
MONITOR_SUBDOMAIN=monitor
GITEA_SUBDOMAIN=git
N8N_SUBDOMAIN=n8n
MATTERMOST_SUBDOMAIN=mattermost

# n8n credential encryption key. Generate once, back it up separately from
# the restic repository password, and never rotate casually:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-run-openssl-rand-hex-32

# Optional Mattermost PostgreSQL password. Required only when enabling
# --profile chat. Generate a long random value
# with:  openssl rand -hex 32
# (use hex, NOT base64 - base64's + / = chars break the postgres:// connection
# string). Used by the mattermost + mattermost-postgres containers. The
# database is internal-only (no host port, no tunnel) - never exposed.
MATTERMOST_DB_PASSWORD=change-me-run-openssl-rand-hex-32

# Optional Podman API socket. Required only when enabling --profile mgmt
# for Portainer. Ubuntu Server rootless default:
PODMAN_SOCKET_PATH=/run/user/1000/podman/podman.sock
# macOS dev: replace with output of:
#   podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}'

# Optional image refs. Replace `latest` with version tags or digests before
# storing important data if you want fully reproducible upgrades.
CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared:latest
PORTAINER_IMAGE=docker.io/portainer/portainer-ce:latest
GLANCES_IMAGE=docker.io/nicolargo/glances:latest
GITEA_IMAGE=docker.io/gitea/gitea:latest
N8N_IMAGE=docker.io/n8nio/n8n:latest
ADGUARD_IMAGE=docker.io/adguard/adguardhome:latest
MATTERMOST_IMAGE=docker.io/mattermost/mattermost-team-edition:release-10.5
POSTGRES_IMAGE=docker.io/postgres:15-alpine
# Pinned separately from POSTGRES_IMAGE on purpose: a PostgreSQL major-version
# bump needs a dump/restore cycle, so a change driven by Mattermost must not
# silently move your application data.
APPDB_IMAGE=docker.io/postgres:17-alpine
ADMINER_IMAGE=docker.io/library/adminer:latest

# Optional Mattermost logical database dump schedule. The chat profile runs this
# before the default 03:00 restic backup so message history has a restore-friendly
# pg_dump alongside the raw PostgreSQL data directory.
MATTERMOST_DB_DUMP_HOUR=2
MATTERMOST_DB_DUMP_MINUTE=45
MATTERMOST_DB_DUMP_KEEP_DAYS=14

# Env store (Infisical) - required only for the `env` profile. Tier B
# (Private): reachable ONLY through Tailscale, never through the tunnel.
#   INFISICAL_ENCRYPTION_KEY: openssl rand -hex 16    (16-byte hex; Infisical
#       uses it to encrypt every stored secret. Keep it OFF the backup disk -
#       a restored backup is unreadable without it.)
#   INFISICAL_AUTH_SECRET:    openssl rand -base64 32 (signs session JWTs)
#   INFISICAL_DB_PASSWORD:    openssl rand -hex 32    (hex, NOT base64 - base64's
#       + / = chars break the postgres:// connection string)
# INFISICAL_SITE_URL is optional; set it to the address clients use, e.g.
# https://infisical.<your-tailnet>.ts.net when fronted by `tailscale serve`.
INFISICAL_PORT=8080
INFISICAL_ENCRYPTION_KEY=change-me-run-openssl-rand-hex-16
INFISICAL_AUTH_SECRET=change-me-run-openssl-rand-base64-32
INFISICAL_DB_PASSWORD=change-me-run-openssl-rand-hex-32
INFISICAL_SITE_URL=

# Logical Infisical database dump schedule (chat-profile pattern). Runs at
# 02:15, after the Umami (02:00) dump and ahead of the appdb (02:30) and
# Mattermost (02:45) dumps and the 03:00 restic backup, so the secret store
# has a restore-friendly pg_dump alongside the raw PostgreSQL data directory.
INFISICAL_DB_DUMP_HOUR=2
INFISICAL_DB_DUMP_MINUTE=15
INFISICAL_DB_DUMP_KEEP_DAYS=14

INFISICAL_IMAGE=docker.io/infisical/infisical:latest
INFISICAL_REDIS_IMAGE=docker.io/redis:7-alpine

# --- Application database (db profile) --------------------------------------
# Private (Tier B) PostgreSQL for your own backend applications, plus Adminer.
# Reachable only over Tailscale: the ports bind ${TAILSCALE_IP}, and the services
# are deliberately kept off the Cloudflare tunnel's network so a public hostname
# created by mistake still cannot route to them. Requires TAILSCALE_ENABLED=true.
#
# Use hex, NOT base64 - base64's + / = characters break the postgres:// string:
#   openssl rand -hex 32
APPDB_SUPERUSER=postgres
APPDB_SUPERUSER_PASSWORD=change-me-run-openssl-rand-hex-32
APPDB_APP_USER=appuser
APPDB_APP_PASSWORD=change-me-run-openssl-rand-hex-32
# Comma-separated databases created on a FRESH cluster only, each owned by
# APPDB_APP_USER. Names must match ^[a-z_][a-z0-9_]{0,62}$. Adding a name later
# does NOT create it on an existing cluster - see deployment.md section 14.
APPDB_DATABASES=app1,app2
APPDB_PORT=5432
ADMINER_PORT=8081

# Logical dump schedule for the application database. Runs before Mattermost's
# 02:45 dump and the 03:00 restic snapshot.
APPDB_DUMP_HOUR=2
APPDB_DUMP_MINUTE=30
APPDB_DUMP_KEEP_DAYS=14

# --- Web analytics (analytics profile) ----------------------------------------
# Umami - privacy-first web analytics. Private (Tier B): reachable only over
# Tailscale, never through the tunnel, so only tailnet devices can reach the
# dashboard AND the collect endpoint (/api/send). That is the right fit for
# measuring your own internal tools; analytics for public websites would need
# a deliberate Tier A decision instead.
#
# Use hex, NOT base64 for the database password - base64's + / = characters
# break the postgres:// connection string:
#   UMAMI_DB_PASSWORD: openssl rand -hex 32
#   UMAMI_APP_SECRET:  openssl rand -hex 32   (signs sessions)
#   UMAMI_2FA_KEY:     openssl rand -hex 32   (64 hex chars; encrypts the TOTP
#       secrets behind 2FA - losing it locks out every 2FA account)
UMAMI_IMAGE=ghcr.io/umami-software/umami:latest
# 3002 rather than umami's native 3000: Gitea's dev port is 127.0.0.1:3000,
# and the loopback fallback bind would collide with it on a dev machine.
UMAMI_PORT=3002
UMAMI_DB_PASSWORD=change-me-run-openssl-rand-hex-32
UMAMI_APP_SECRET=change-me-run-openssl-rand-hex-32
UMAMI_2FA_KEY=change-me-run-openssl-rand-hex-32

# Logical analytics dump schedule (chat-profile pattern). Runs at 02:00 -
# second in the nightly sequence, after the GlitchTip (01:45) dump and ahead
# of the infisical (02:15), appdb (02:30), and Mattermost (02:45) dumps and
# the 03:00 restic snapshot.
UMAMI_DB_DUMP_HOUR=2
UMAMI_DB_DUMP_MINUTE=0
UMAMI_DB_DUMP_KEEP_DAYS=14

# --- App-error monitoring (monitoring profile) ---------------------------------
# GlitchTip - Sentry-compatible error monitoring for your applications.
# Private (Tier B): reachable only over Tailscale, never through the tunnel, so
# only tailnet devices and first-party containers can reach the UI AND the
# event-ingest endpoints (DSN / OTLP). That fits monitoring your own internal
# tools; monitoring public-facing apps' client-side errors would need a
# deliberate Tier A decision instead.
#
# Use hex, NOT base64 for the database password - base64's + / = characters
# break the postgres:// connection string:
#   GLITCHTIP_SECRET_KEY:   openssl rand -hex 32   (Django SECRET_KEY; signs
#       sessions and reset tokens - keep it off the backup disk)
#   GLITCHTIP_DB_PASSWORD:  openssl rand -hex 32
GLITCHTIP_IMAGE=docker.io/glitchtip/glitchtip:6
# Upstream recommends Valkey (open-source Redis fork); same protocol.
GLITCHTIP_VALKEY_IMAGE=docker.io/valkey/valkey:9-alpine
# 8082 continues the Tier B port row: 8080 Infisical, 8081 Adminer.
GLITCHTIP_PORT=8082
GLITCHTIP_SECRET_KEY=change-me-run-openssl-rand-hex-32
GLITCHTIP_DB_PASSWORD=change-me-run-openssl-rand-hex-32
# Recommended: the address apps and browsers use, e.g. http://<tailscale-ip>:8082
# (or the https://...ts.net address when fronted by `tailscale serve` - then also
# set GLITCHTIP_CSRF_TRUSTED_ORIGINS to that origin). Empty falls back to
# http://localhost:8080.
GLITCHTIP_DOMAIN=
# Email defaults to the container log (consolemail://). Set an smtp:// URL to
# send alert mail, plus GLITCHTIP_DEFAULT_FROM_EMAIL.
GLITCHTIP_EMAIL_URL=
GLITCHTIP_DEFAULT_FROM_EMAIL=
# false (default) keeps signup open only while the user table is empty: the
# first user registers, then registration closes. New users come from a
# superuser or invites afterwards.
GLITCHTIP_ENABLE_USER_REGISTRATION=

# Logical monitoring dump schedule (chat-profile pattern). Runs first in the
# nightly sequence (01:45), ahead of the umami (02:00), infisical (02:15),
# appdb (02:30), and Mattermost (02:45) dumps and the 03:00 restic snapshot.
GLITCHTIP_DB_DUMP_HOUR=1
GLITCHTIP_DB_DUMP_MINUTE=45
GLITCHTIP_DB_DUMP_KEEP_DAYS=14
